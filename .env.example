# ---------------------------------------------------------------
# MelanoTrack environment. Copy to `.env` and fill in real secrets.
# NEVER commit `.env`.
# ---------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=melanotrack
POSTGRES_USER=melanotrack
POSTGRES_PASSWORD=change-me-db-password

# Auth: generate with  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# File encryption master key (32 random bytes, base64).
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# !!! BACK THIS UP SEPARATELY. Losing it = losing every stored file. !!!
STORAGE_MASTER_KEY=change-me

# Seed accounts (created on first start)
SEED_SUPERADMIN_EMAIL=admin@melanotrack.example
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026
SEED_DEMO=true

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# AI model service
MODEL_ADAPTER=mock
MODEL_DIR=/models/mock/0.1.0
MOCK_FORCE_ERROR=0
INFERENCE_TIMEOUT_S=60
